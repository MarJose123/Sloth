      ]
    }
  },
  "scripts": {
    "dev": "APP_VARIANT=development bun expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "lint": "prettier --write . && expo lint . --fix",
    "test": "jest",
    "eas:build:dev": "bunx eas-cli build --platform=android --profile=development"
