  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/setup\\.ts$",
      "/src/__tests__/testUtils\\.ts$"
